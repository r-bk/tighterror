module errors {
    spec {
        doc-from-display #true
        err-doc "A custom error struct doc."
        err-kind-doc "A custom error doc."
        err-cat-doc "A custom category doc."
        result-from-err #false
        result-from-err-kind #false
        error-trait #false
        err-name IcError
        err-kind-name IcErrorKind
        err-cat-name IcErrorCategory
    }
    category General {
        spec { doc "General error category." }
        error FAILED_TO_OPEN_FILE display="Input file could not be open."
        error BAD_INPUT display="Input file has invalid format."
        error LONG_DESCRIPTION {
            spec {
                doc """
                    This is an example for a long doc string.

                    It continues on several lines. And can include Rust doc-string
                    formatting [`String`].
                    """
            }
        }
    }
}
