module errors {
    spec {
        doc-from-display #true
        flat-kinds #false
        repr u16
    }
    category Render {
        spec {
            doc "Errors of the render crate."
            error-type test_wrap_render::errors::Error
            kind-type test_wrap_render::errors::ErrorKind
        }
    }
    category Text {
        spec {
            doc "Errors of the text crate."
            error-type test_wrap_text::errors::Error
            kind-type test_wrap_text::errors::ErrorKind
        }
    }
    category Io {
        spec { doc "I/O errors category." }
        error CONNECTION_REFUSED display="Outgoing network connection was refused."
    }
}

module relay {
    category Render {
        spec {
            doc "Errors of the render crate."
            error-type test_wrap_render::errors::Error
            kind-type test_wrap_render::errors::ErrorKind
        }
    }
    category Text {
        spec {
            doc "Errors of the text crate."
            error-type test_wrap_text::errors::Error
            kind-type test_wrap_text::errors::ErrorKind
        }
    }
}
