module internal_errors {
    spec {
        flat-kinds #false
        doc-from-display #true
    }
    category Parser {
        spec { doc "Parser errors category." }
        error BAD_FILE display="Configuration file is malformed."
    }
    category Processor {
        spec { doc "Processor errors category." }
        error BAD_FILE display="Processor file is malformed or missing."
        error BAD_STATE display="Internal error, state mismatch."
    }
}

module errors {
    spec {
        flat-kinds #false
        doc-from-display #true
        err-doc "A custom error struct doc."
        err-kind-doc "A custom error doc."
        err-cat-doc "A custom category doc."
        error-trait #true
        result-from-err #true
        result-from-err-kind #true
        err-name McError
        err-kind-name McErrorKind
        err-cat-name McErrorCategory
    }
    category Parsing {
        spec { doc "Parsing errors category." }
        error BAD_TOKEN display="Decoded an invalid token."
        error QUEUE_FULL display="Parsing queue is full."
    }
    category Processing {
        spec { doc "Processing errors category." }
        error OUT_OF_MEMORY display="Memory pool is empty."
        error QUEUE_FULL display="Processing queue is full."
        error WITHOUT_DISPLAY {
            spec {
                doc "An error without display string."
                variant-type #true
            }
        }
        error WITHOUT_DOC display="An error without doc string." {
            spec { variant-type #true }
        }
    }
    category General {
        spec { doc "General errors category." }
        error BAD_ARG display="Invalid argument received." {
            spec {
                doc """
                    An invalid argument was received.

                    # Examples

                    ```rust
                    # struct Error;
                    # impl From<u32> for Error {
                    #     fn from(v: u32) -> Self {
                    #         Self{}
                    #     }
                    # }
                    # const BAD_ARG: u32 = 0;
                    let e: Error = BAD_ARG.into();
                    ```
                    """
            }
        }
        error TIMEOUT display="Operation timed out."
    }
}

module flat_kinds_mod {
    spec {
        flat-kinds #true
        doc-from-display #true
        variant-type #true
    }
    category CatOne {
        spec { doc "Category #1" }
        error CAT_ONE_ERR_ONE display="CatOne error #1"
        error CAT_ONE_ERR_TWO display="CatOne error #2"
        error CAT_ONE_WITHOUT_DISPLAY {
            spec { doc "A CatOne error without display string." }
        }
        error CAT_ONE_WITHOUT_DOC display="An error without doc string."
    }
    category CatTwo {
        spec { doc "Category #2" }
        error CAT_TWO_ERR_ONE display="CatTwo error #1"
        error CAT_TWO_ERR_TWO display="CatTwo error #2"
        error CAT_TWO_WITHOUT_DISPLAY {
            spec {
                doc "A CatTwo error without display string."
                variant-type CatTwoSpecial
            }
        }
    }
}

module flat_kinds_mod_without_display {
    spec {
        flat-kinds #true
        variant-type #true
    }
    category CatOne {
        spec { doc "Category #1" }
        error CAT_ONE_ERR_ONE {
            spec { doc "CatOne error #1" }
        }
        error CAT_ONE_ERR_TWO {
            spec { doc "CatOne error #2" }
        }
    }
    category CatTwo {
        spec { doc "Category #2" }
        error CAT_TWO_ERR_ONE {
            spec { doc "CatTwo error #1" }
        }
        error CAT_TWO_ERR_TWO {
            spec { doc "CatTwo error #2" }
        }
        error CAT_TWO_CUSTOM_NAME {
            spec {
                doc "A CatTwo error without display string."
                variant-type CatTwoCustomVariantTypeName
            }
        }
    }
}
